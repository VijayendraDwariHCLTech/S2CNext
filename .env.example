# Put values in Railway's Variables tab. NEVER commit real values.
NODE_ENV=production
# Set by Railway automatically: PORT
# MySQL service reference: ${{MySQL.MYSQL_URL}} (match actual Railway service name)
DATABASE_URL=mysql://placeholder:placeholder@mysql-host:3306/railway
# 32+ random bytes, generated by a cryptographically secure tool; not an auth login by itself.
JWT_SECRET=replace-with-a-long-random-secret
# Optional: omit Foundry keys until the tenant connectivity is validated.
FOUNDRY_APP_KEY=
FOUNDRY_APP_SECRET=
# Optional only when an approved integration supplies them:
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
